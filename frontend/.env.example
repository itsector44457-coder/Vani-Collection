# Vani Collection storefront — environment template.
#
#   cp .env.example .env.local
#
# Every value here is a safe default; the app builds and runs with this file untouched. Put real
# credentials in `.env.local`, which is gitignored. Do NOT commit `.env.local`.
#
# Both variables are inlined at BUILD time (the `NEXT_PUBLIC_` prefix ships them to the browser and
# bakes them into the server bundle), so changing either requires a rebuild, not just a restart.

# Base URL of the Express backend in ../backend (it listens on 5000 by default).
# Unset  -> the storefront renders its bundled demo catalogue and the admin console shows a
#          "Demo data" badge on every panel. Nothing throws; this is the supported no-config mode.
# Set    -> live catalogue, cart, orders, auth and admin data.
NEXT_PUBLIC_API_URL=

# Canonical public origin of the storefront, used for every absolute URL we publish:
#   - <link rel="canonical"> and the Open Graph / Twitter url
#   - app/sitemap.xml entries and the Sitemap: line in app/robots.txt
#   - all schema.org JSON-LD (@id, url, offers.url, breadcrumb items)
#   - next/image resolution and the generated Open Graph cards
#
# Must be the real public origin with no trailing slash, e.g. https://www.vanicollection.com.
# On a deployment without a custom domain yet (Vercel preview, an internal host), set it to the
# canonical production origin anyway — never to the preview URL, or Google will be handed
# canonicals and structured data pointing at throwaway hosts.
#
# Keep this in step with the backend's STOREFRONT_URL, which builds the links inside customer
# emails; the two should be the same origin.
NEXT_PUBLIC_SITE_URL=https://www.vanicollection.com
