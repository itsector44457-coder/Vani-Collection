    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
