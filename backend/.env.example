NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vani_collection
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) when the storefront and the API are on
# different sites; keep 'lax' when they share a domain (api.example.com + www.example.com).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Bootstrap admin (used only by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-before-running-seed

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# Rishabh ERP — obtain exact paths/field contract from the Ujjain vendor
ERP_ENABLED=false
ERP_BASE_URL=
ERP_AUTH_HEADER=Authorization
ERP_AUTH_TOKEN=
ERP_PRODUCTS_PATH=/api/products
ERP_STOCK_PATH=/api/stock
ERP_ORDERS_PATH=/api/orders
ERP_TIMEOUT_MS=15000
ERP_WEBHOOK_SECRET=

# Optional media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (the ONLY notification channel — no WhatsApp/SMS/push in this codebase)
#
# Provider agnostic SMTP: Gmail, Amazon SES, Resend, Postmark, Zoho, Mailgun…
# Leave EMAIL_ENABLED=false to run with zero config: every trigger logs its
# intent, writes a `skipped` EmailLog row and the shopper never sees an error.
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM="Vani Collection <care@vanicollection.com>"
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# When true the fully rendered email (subject + text + html) is written to the log
# instead of being handed to SMTP — handy in development and for staging reviews.
EMAIL_DEV_CAPTURE=true
# Absolute URL of the brand mark shown in the email header. Empty = CSS monogram fallback
# (preferred: many mail clients block SVG/remote images).
EMAIL_LOGO_URL=
# Canonical storefront origin used for every link inside emails (order tracking, reset link…).
# Defaults to the first entry of CORS_ORIGINS.
STOREFRONT_URL=
# Support inbox printed in the email footer.
SUPPORT_EMAIL=care@vanicollection.com

# Local development ONLY: some ISP resolvers refuse the SRV lookups a mongodb+srv:// URI needs.
# Set to e.g. "8.8.8.8,1.1.1.1" on a laptop that cannot resolve the Atlas SRV record.
# NEVER set DNS_SERVERS in production — the host resolver is already correct there.
DNS_SERVERS=
