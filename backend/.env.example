NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vani_collection
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) when the storefront and the API are on
# different sites; keep 'lax' when they share a domain (api.example.com + www.example.com).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Bootstrap admin (used only by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-before-running-seed

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# Rishabh ERP — obtain exact paths/field contract from the Ujjain vendor
ERP_ENABLED=false
ERP_BASE_URL=
ERP_AUTH_HEADER=Authorization
ERP_AUTH_TOKEN=
ERP_PRODUCTS_PATH=/api/products
ERP_STOCK_PATH=/api/stock
ERP_ORDERS_PATH=/api/orders
ERP_TIMEOUT_MS=15000
ERP_WEBHOOK_SECRET=

# Optional media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (the ONLY notification channel — no WhatsApp/SMS/push in this codebase)
#
# Provider agnostic SMTP: Gmail, Amazon SES, Resend, Postmark, Zoho, Mailgun…
# Leave EMAIL_ENABLED=false to run with zero config: every trigger logs its
# intent, writes a `skipped` EmailLog row and the shopper never sees an error.
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM="Vani Collection <care@vanicollection.com>"
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# When true the fully rendered email (subject + text + html) is written to the log
# instead of being handed to SMTP — handy in development and for staging reviews.
EMAIL_DEV_CAPTURE=true
# Absolute URL of the brand mark shown in the email header. Empty = CSS monogram fallback
# (preferred: many mail clients block SVG/remote images).
EMAIL_LOGO_URL=
# Canonical storefront origin used for every link inside emails (order tracking, reset link…).
# Defaults to the first entry of CORS_ORIGINS.
STOREFRONT_URL=
# Support inbox printed in the email footer.
SUPPORT_EMAIL=care@vanicollection.com

# --------------------------------------------------------------------- GST invoice
# Seller identity printed on every tax invoice (GET /api/orders/:id/invoice.pdf).
# All of it is optional: with nothing set the invoice still renders and states plainly that the
# supplier is unregistered, rather than printing a fabricated registration number.
#
# SELLER_GSTIN is the one that matters for GST. It must be a valid 15-character GSTIN
# (2-digit state code + 10-character PAN + entity code + Z + checksum); a malformed value refuses
# to boot (Zod config validation), rather than putting an invalid registration number on an invoice.
SELLER_GSTIN=
# Derived from SELLER_GSTIN when omitted — set only if the invoice should show a different PAN.
SELLER_PAN=
SELLER_LEGAL_NAME=Vani Collection
SELLER_ADDRESS=Vani Collection Atelier, Guna, Madhya Pradesh 473001, India
# Decides CGST+SGST (same state) versus IGST (different state). Defaults to the state encoded in
# SELLER_GSTIN, so setting the GSTIN alone is normally enough.
SELLER_STATE=
SELLER_STATE_CODE=
SELLER_PHONE=
SELLER_EMAIL=care@vanicollection.com

# Optional TrueType font to embed in the PDF.
#
# Leave these unset unless you specifically want the ₹ glyph. pdfkit's built-in Helvetica is a
# base-14 font in WinAnsiEncoding, which has no U+20B9 — it does not error, it silently emits byte
# 0xB9, which renders as a superscript one. So "₹1,23,456" would print as "¹1,23,456" on a legal tax
# document. The default output therefore writes "Rs." and needs no font file at all.
#
# Point these at a font that carries the glyph (DejaVu Sans does) and the renderer switches to ₹
# automatically. The symbol always follows the font actually loaded, so an invoice can never claim a
# glyph it cannot draw. Slim container images ship no fonts, so the file must be present at runtime.
INVOICE_FONT_PATH=
INVOICE_FONT_BOLD_PATH=

# --------------------------------------------------------------------------- loyalty
# Internal bookkeeping only — no external provider, so the programme works with every
# value below left at its default. Set LOYALTY_ENABLED=false to stop earning and redeeming.
LOYALTY_ENABLED=true
# Order value (rupees) that earns one point, counted on delivered orders only.
LOYALTY_RUPEES_PER_POINT=100
# Rupees of checkout discount one point is worth. Redemption is always whole rupees.
LOYALTY_POINT_VALUE_RUPEES=1
# Fewest points a shopper may redeem at once — keeps ₹1 coupons out of the system.
LOYALTY_MIN_REDEMPTION_POINTS=100
# Points may cover at most this percentage of an order, so a discount can never exceed
# the value of the goods. 0 disables redemption.
LOYALTY_MAX_REDEMPTION_PERCENT=50
# Earned points lapse after this many months.
LOYALTY_EXPIRY_MONTHS=12
# Points awarded to BOTH the referrer and the shopper they referred.
LOYALTY_REFERRAL_BONUS_POINTS=200
# Lifetime-point thresholds for the upper tiers. Everything below Gold is Silver.
LOYALTY_TIER_GOLD_POINTS=1000
LOYALTY_TIER_PLATINUM_POINTS=5000
# Days a redeemed coupon stays claimable at checkout before it lapses.
LOYALTY_COUPON_VALID_DAYS=30

# Local development ONLY: some ISP resolvers refuse the SRV lookups a mongodb+srv:// URI needs.
# Set to e.g. "8.8.8.8,1.1.1.1" on a laptop that cannot resolve the Atlas SRV record.
# NEVER set DNS_SERVERS in production — the host resolver is already correct there.
DNS_SERVERS=
